# Anthropic API key for answers. Leave empty to use an `ant auth login` profile instead.
ANTHROPIC_API_KEY=
# Model that writes the answers.
LLM_MODEL=claude-opus-5-5
# Reasoning effort passed to the model: low, medium or high.
LLM_EFFORT=medium
# Claim check: a second call grades each cited sentence against its passage. Set VERIFY=false to turn it off.
VERIFY=true
# Model for the claim check; empty uses LLM_MODEL. Its effort is low by default.
VERIFY_MODEL=
VERIFY_EFFORT=low
# Agentic retrieval: the model runs follow-up searches before answering (more calls). AGENT_ROUNDS caps its turns.
AGENTIC=false
AGENT_ROUNDS=3
# auto reranks the top RERANK_DEPTH candidates with a cross-encoder (needs the embed extra; downloads the model once).
RERANK=off
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_DEPTH=30
# auto uses multilingual-e5 embeddings when the embed extra is installed; off is BM25 only.
EMBED=auto
# Where papers and the index are stored (relative paths start at the repo root).
DATA_DIR=data
# Host headers the web app accepts, comma-separated. Add your own hostname only when serving beyond this machine.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Shared secret for POST /api/ask (sent as the X-API-Token header). Leave empty for local use; set it for any other use.
API_TOKEN=
# Spend limits for /api/ask when others can reach the server (0 = none): per visitor address per hour, and per day.
# python -m app.serve (the container) needs API_TOKEN or both of these.
ASK_LIMIT_PER_HOUR=0
ASK_LIMIT_PER_DAY=0
# Seconds between arXiv requests; arXiv asks for at least 3.
ARXIV_DELAY_S=3
